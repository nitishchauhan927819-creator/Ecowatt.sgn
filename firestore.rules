rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & settings
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Optimization runs & saved schedules
    match /users/{userId}/runs/{runId} {
      allow read, write: if isOwner(userId);
    }

    // Custom deferrable appliances / loads
    match /users/{userId}/loads/{loadId} {
      allow read, write: if isOwner(userId);
    }

    // Global / shared demo presets and public telemetry benchmarks
    match /benchmarks/{benchmarkId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
